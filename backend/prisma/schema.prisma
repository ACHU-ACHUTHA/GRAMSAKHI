generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?  @unique
  age       Int?
  password  String?
  village   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patients  Patient[]
}

model Patient {
  id             String        @id @default(uuid())
  name           String
  age            Int
  gender         String
  phone          String?
  village        String
  workerId       String
  worker         Worker        @relation(fields: [workerId], references: [id])
  medicalHistory String?
  bloodGroup     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  symptoms       SymptomLog[]
  emergencies    Emergency[]
}

model SymptomLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  symptoms   String   // Stored as JSON or comma-separated
  riskLevel  String   // Low, Moderate, High
  notes      String?
  createdAt  DateTime @default(now())
}

model Emergency {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  description String
  status      String   // Active, Resolved
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}
